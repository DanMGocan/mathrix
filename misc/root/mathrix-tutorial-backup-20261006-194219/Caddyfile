{
	servers {
		max_header_size 32KB
		# Cloudflare's published IPv4 and IPv6 ranges; refresh when those lists change.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		trusted_proxies_strict
	}
}
www.mathrix.app {
	redir https://mathrix.app{uri} permanent
}
mathrix.app {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
	}
	@designUpload {
		method POST
		path /api/admin/design-files
	}
	handle @designUpload {
		request_body {
			max_size 11MB
		}
		reverse_proxy 127.0.0.1:3001 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	@billingWebhook {
		method POST
		path /api/billing/webhook
	}
	handle @billingWebhook {
		request_body {
			max_size 256KB
		}
		reverse_proxy 127.0.0.1:3001 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	@backend path /api/* /socket.io/*
	handle @backend {
		request_body {
			max_size 32KiB
		}
		reverse_proxy 127.0.0.1:3001 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	log {
		output file /var/log/caddy/mathrix-access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format json
	}
}
