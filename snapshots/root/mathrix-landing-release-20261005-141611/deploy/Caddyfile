{
	servers {
		max_header_size 32KB
	}
}
www.mathrix.app {
	redir https://mathrix.app{uri} permanent
}
mathrix.app {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
	}
	@designUpload {
		method POST
		path /api/admin/design-files
	}
	handle @designUpload {
		request_body {
			max_size 11MB
		}
		reverse_proxy 127.0.0.1:3001
	}
	@billingWebhook {
		method POST
		path /api/billing/webhook
	}
	handle @billingWebhook {
		request_body {
			max_size 256KB
		}
		reverse_proxy 127.0.0.1:3001
	}
	@backend path /api/* /socket.io/*
	handle @backend {
		request_body {
			max_size 32KB
		}
		reverse_proxy 127.0.0.1:3001
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
	log {
		output file /var/log/caddy/mathrix-access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format json
	}
}
# Temporary direct-IP HTTP access for diagnostics; authentication uses the HTTPS domain.
http://152.53.14.163 {
	@backend path /api/* /socket.io/*
	handle @backend {
		reverse_proxy 127.0.0.1:3001
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
